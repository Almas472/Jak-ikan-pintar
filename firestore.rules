rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPond(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.type in ['biofloc', 'non-biofloc'] &&
             data.fishCount is int &&
             data.fishAge is int &&
             data.temperature is number &&
             data.feedLevel is number;
    }

    function isValidSchedule(data) {
      return data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$') &&
             data.amount is int &&
             data.enabled is bool;
    }

    function isValidLog(data) {
      return data.pondId is string &&
             data.amount is int &&
             data.status in ['success', 'failed'];
    }

    // Pond Rules
    match /ponds/{pondId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPond(request.resource.data);
      allow update: if isSignedIn() && isValidPond(request.resource.data);
      allow delete: if isSignedIn();

      match /schedules/{scheduleId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (request.method == 'delete' || isValidSchedule(request.resource.data));
      }
    }

    // Logs Rules
    match /feeding_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidLog(request.resource.data);
    }
  }
}
